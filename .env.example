NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEWS_PROVIDER=mock
EDITORIAL_PROVIDER=mock
TTS_PROVIDER=xiaomi-mimo
MIMO_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
DAILYBOKE_DATA_FILE=

# New unpublished previews stay outside public/, never uploaded to a public bucket.
DAILYBOKE_PRIVATE_AUDIO_DIR=
# Required to expose the local review app externally. Username: review.
REVIEW_ACCESS_TOKEN=

# local keeps offline development working. Set r2 only after filling every R2 field.
AUDIO_STORAGE_PROVIDER=local
# s3 for server deployment; wrangler uses the local official CLI OAuth login.
R2_UPLOAD_MODE=s3
R2_ACCOUNT_ID=
# Optional override for jurisdiction-specific S3 endpoints; normally leave empty.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Stable HTTPS media Worker URL (no owned domain required), or an optional custom media domain.
R2_PUBLIC_BASE_URL=
# Only set to 1 for r2.dev testing, not production podcast distribution.
R2_ALLOW_DEV_PUBLIC_URL=0
